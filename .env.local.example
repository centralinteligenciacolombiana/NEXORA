# Copia este archivo como `.env.local` y rellena los valores.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Service role (servidor): confirmar email y generateLink. NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Resend (confirmación de correo) ---
RESEND_API_KEY=re_xxxxxxxx
# Pruebas: onboarding@resend.dev | Producción: NEXORA <no-reply@tu-dominio.com>
RESEND_FROM_EMAIL=NEXORA <onboarding@resend.dev>
